rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dev-friendly rules for POC. Tighten before production.
    match /consent_requests/{id} {
      allow read, write: if request.auth != null;
    }
    match /consent_devices/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
